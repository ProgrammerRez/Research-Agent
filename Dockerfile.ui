FROM python:3.10-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Streamlit frontend and required execution schemas
COPY streamlit_app.py schema.py ./

EXPOSE 8501

ENV PYTHONUNBUFFERED=1

# Configure streamlit runtime to stop file watchers inside container spaces
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.fileWatcherType=none"]